{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "dataconnect/**",
      "src/**",
      "specs/**",
      "agents.md",
      "firebase-debug.log"
    ]
  }
}
